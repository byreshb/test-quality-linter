{
  "name": "tql-action",
  "version": "1.1.0",
  "private": true,
  "description": "GitHub Action that runs the Test Quality Linter and uploads SARIF to code scanning.",
  "type": "module",
  "license": "Apache-2.0",
  "scripts": {
    "build": "ncc build src/index.ts -o dist --minify",
    "test": "vitest run",
    "lint": "eslint .",
    "format": "prettier --write .",
    "check": "tsc --noEmit && npm run lint && prettier --check ."
  },
  "devDependencies": {
    "@types/node": "22.20.2",
    "@vercel/ncc": "0.45.0",
    "@vitest/coverage-v8": "3.2.7",
    "eslint": "9.39.5",
    "prettier": "3.9.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0",
    "vitest": "3.2.7"
  }
}
